{
  "openapi": "3.0.3",
  "info": {
    "title": "Slotly — Booking API",
    "version": "1.0.0",
    "description": "Контракт MVP системы онлайн-записи на услуги. Этап системного проектирования; сервер не развёрнут."
  },
  "servers": [
    {
      "url": "https://api.slotly.example/v1",
      "description": "Демонстрационный адрес, не действующий сервис"
    }
  ],
  "tags": [
    {
      "name": "Catalog"
    },
    {
      "name": "Appointments"
    },
    {
      "name": "Admin"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/services": {
      "get": {
        "operationId": "listServices",
        "tags": [
          "Catalog"
        ],
        "summary": "Список активных услуг",
        "security": [],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Service"
                  }
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/slots": {
      "get": {
        "operationId": "listSlots",
        "tags": [
          "Catalog"
        ],
        "summary": "Доступные слоты на дату",
        "security": [],
        "description": "Не резервирует время. Только опубликованные слоты активной услуги, startsAt > now, без CONFIRMED; сортировка startsAt, id. Неактивная известная услуга → []; неизвестная → 404.",
        "parameters": [
          {
            "name": "serviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Услуга"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Локальная дата Europe/Saratov. Для /slots: сегодня и 29 следующих дат; для admin — любая корректная дата."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: объект отсутствует или запись принадлежит другому клиенту",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR: схема, параметры или горизонт даты нарушены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/appointments": {
      "post": {
        "operationId": "createAppointment",
        "tags": [
          "Appointments"
        ],
        "summary": "Создать запись (роль client)",
        "description": "clientId берётся из токена. Существующий недоступный слот → 409 SLOT_UNAVAILABLE. Успешный ответ кэшируется 24 часа по clientId и ключу. Тот же ключ/slotId → исходный 201 и тело, даже после отмены; иной slotId → 409 IDEMPOTENCY_KEY_REUSED. Неуспешные результаты не кэшируются. После TTL повторная обработка допустима.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Новый UUID для намерения создать запись; при сетевом повторе сохранить ключ"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAppointment"
              },
              "example": {
                "slotId": "11111111-1111-4111-8111-111111111111"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Запись создана или воспроизведён исходный успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_JSON: некорректный JSON (для POST)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: токен отсутствует, истёк или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: роль не разрешает операцию",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: объект отсутствует или запись принадлежит другому клиенту",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт бизнес-правила; см. описание операции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR: схема, параметры или горизонт даты нарушены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/{id}": {
      "get": {
        "operationId": "getAppointment",
        "tags": [
          "Appointments"
        ],
        "summary": "Получить свою запись; admin может получить любую",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID записи"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: токен отсутствует, истёк или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: роль не разрешает операцию",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: объект отсутствует или запись принадлежит другому клиенту",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR: схема, параметры или горизонт даты нарушены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/{id}/cancel": {
      "post": {
        "operationId": "cancelAppointment",
        "tags": [
          "Appointments"
        ],
        "summary": "Отменить запись",
        "description": "client: только своя и не менее 2 часов до startsAt (граница включена). admin: любая строго до startsAt. Закрытое окно → 409 CANCELLATION_WINDOW_CLOSED. Уже CANCELLED → 200 без изменений, независимо от времени; авторизация и валидация причины всё равно обязательны.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID записи"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelAppointment"
              },
              "example": {
                "reason": "Изменились планы"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Отменено или уже отменено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_JSON: некорректный JSON (для POST)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: токен отсутствует, истёк или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: роль не разрешает операцию",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: объект отсутствует или запись принадлежит другому клиенту",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт бизнес-правила; см. описание операции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR: схема, параметры или горизонт даты нарушены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/appointments": {
      "get": {
        "operationId": "listDayAppointments",
        "tags": [
          "Admin"
        ],
        "summary": "Все записи на локальную дату слота (роль admin)",
        "description": "CONFIRMED и CANCELLED; сортировка startsAt, id. Без пагинации в пределах одной студии и одного дня.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Локальная дата Europe/Saratov. Для /slots: сегодня и 29 следующих дат; для admin — любая корректная дата."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Appointment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: токен отсутствует, истёк или недействителен",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: роль не разрешает операцию",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR: схема, параметры или горизонт даты нарушены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: повтор создания с исходным ключом при неизвестном результате",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Доверенный внешний IdP; роли client/admin, subject как clientId"
      }
    },
    "schemas": {
      "Service": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 240
          }
        },
        "required": [
          "id",
          "name",
          "durationMinutes"
        ]
      },
      "Slot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "specialistId": {
            "type": "string",
            "format": "uuid"
          },
          "specialistName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "serviceId",
          "specialistId",
          "specialistName",
          "startsAt",
          "endsAt"
        ]
      },
      "CreateAppointment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "slotId"
        ]
      },
      "CancelAppointment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S",
            "description": "После trim от 1 до 500 символов; хранить trim-значение. Не логировать."
          }
        },
        "required": [
          "reason"
        ]
      },
      "Appointment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slotId": {
            "type": "string",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "WEB"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelledBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "nullable": true
          },
          "cancellationReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "nullable": true
          }
        },
        "required": [
          "id",
          "slotId",
          "clientId",
          "status",
          "source",
          "startsAt",
          "endsAt",
          "createdAt",
          "cancelledAt",
          "cancelledBy",
          "cancellationReason"
        ],
        "description": "CONFIRMED: поля cancelledAt/By/Reason равны null. CANCELLED: все три непустые. Время берётся из неизменяемого слота. Реализация обязана проверять зависимость полей от статуса.",
        "example": {
          "id": "22222222-2222-4222-8222-222222222222",
          "slotId": "11111111-1111-4111-8111-111111111111",
          "clientId": "demo-client-a",
          "status": "CONFIRMED",
          "source": "WEB",
          "startsAt": "2026-09-10T10:00:00+04:00",
          "endsAt": "2026-09-10T11:00:00+04:00",
          "createdAt": "2026-09-10T08:00:00+04:00",
          "cancelledAt": null,
          "cancelledBy": null,
          "cancellationReason": null
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_JSON",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "SLOT_UNAVAILABLE",
              "IDEMPOTENCY_KEY_REUSED",
              "CANCELLATION_WINDOW_CLOSED",
              "VALIDATION_ERROR",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      }
    }
  }
}
